{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ONight Business",
  "version": "0.1.0",
  "identifier": "ma.elan.cosmetics.management",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ONight — Gestion commerciale",
        "width": 1440,
        "height": 900,
        "minWidth": 1060,
        "minHeight": 700,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://localhost:4000 https:; font-src 'self' https://fonts.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' asset: https: data:"
    }
  },
  "bundle": {
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Wholesale cosmetics management",
    "longDescription": "Manage cosmetics inventory, wholesale sales, purchases, customer credit and reporting."
  }
}
