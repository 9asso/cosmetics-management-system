{
  "name": "cosmetics-commerce-platform",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:external": "turbo dev",
    "dev:vps": "node scripts/dev-vps.mjs",
    "dev:api": "node scripts/dev-local.mjs --api-only",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:local": "node scripts/test-local.mjs",
    "lint": "turbo lint",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @cosmetics/api db:migrate",
    "import:catalog-demo": "node scripts/import-catalog-demo.mjs",
    "deploy:vps": "node scripts/deploy-vps.mjs"
  },
  "devDependencies": {
    "@types/ssh2": "^1.15.6",
    "dotenv": "^17.4.2",
    "embedded-postgres": "17.10.0-beta.17",
    "prettier": "^3.6.2",
    "ssh2": "^1.17.0",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "cpu-features",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/linux-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/windows-x64",
      "esbuild",
      "ssh2"
    ]
  }
}
