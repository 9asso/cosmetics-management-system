{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm --filter @cosmetics/contracts build && VITE_API_URL=/api/v1 VITE_BASE_PATH=/ pnpm --filter @cosmetics/desktop build",
  "outputDirectory": "apps/desktop/dist",
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "http://162.35.107.230/api/v1/:path*"
    },
    {
      "source": "/products/catalog/:path*",
      "destination": "http://162.35.107.230/products/catalog/:path*"
    },
    { "source": "/:path*", "destination": "/index.html" }
  ]
}
